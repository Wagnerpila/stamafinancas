# Local SQLite database file
DATABASE_URL="file:./dev.db"

# Change this to a long random string in any real deployment
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

PORT=3001

# Origin(s) allowed to call the API. Comma-separated. Leave as-is for local Vite dev.
CORS_ORIGIN="http://localhost:5173"

# First user to register with this email is auto-promoted to admin.
ADMIN_EMAIL="wagtecaut@gmail.com"

# --- AI provider (optional) ---------------------------------------------
# Leave AI_PROVIDER unset (or "none") to run without AI features enabled.
# The app will keep working; AI-powered actions (OCR, voice/text parsing,
# monthly insights, consulting chat, statement import) will return a clear
# "AI not configured" error instead of crashing.
#
# Opção GRATUITA (recomendada pra testes): Google Gemini — crie a chave em
# https://aistudio.google.com/apikey (plano gratuito). Também transcreve os
# áudios do WhatsApp.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Email / "Esqueci minha senha" (optional) ----------------------------
# Sem essas variáveis, o app segue funcionando normalmente — só o botão
# "Esqueci minha senha" retorna um erro claro em vez de travar silenciosamente.
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu
# email, SMTP_PASS=uma "senha de app" (não a senha normal da conta Google).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM="STAMA <seuemail@gmail.com>"

# URL pública do app, usada para montar o link de redefinição de senha no
# email. Se não definida, usa o host da própria requisição (funciona na
# maioria dos casos; defina explicitamente se estiver atrás de proxy/CDN).
# APP_URL=https://seu-dominio.com

# Transcrição dos áudios do WhatsApp: usa Gemini se GEMINI_API_KEY estiver
# definida; senão Groq (também gratuito, https://console.groq.com/keys); senão
# OpenAI (pago).
# GROQ_API_KEY=...

# --- WhatsApp bot (optional) ---------------------------------------------
# Não usa a API oficial da Meta — conecta via WhatsApp Web, escaneando um QR
# Code uma única vez no Painel Admin do app. Dois transportes gratuitos:
#
#   baileys   (padrão) conexão direta dentro deste servidor. A sessão é salva
#             ao lado do banco SQLite, então persiste entre deploys.
#   evolution Evolution API self-hosted (veja docker-compose.evolution.yml na
#             raiz). As mensagens chegam por webhook em /api/whatsapp/webhook.
#
# WHATSAPP_PROVIDER=baileys
# WHATSAPP_SESSION_DIR=/app/data/whatsapp-session
# WHATSAPP_LOG_LEVEL=silent
#
# WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_API_KEY=mesma-AUTHENTICATION_API_KEY-da-evolution
# EVOLUTION_INSTANCE=financas
# # URL deste backend vista de dentro do container da Evolution:
# EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3001/api/whatsapp/webhook
# WHATSAPP_WEBHOOK_TOKEN=um-segredo-qualquer
#
# Avisos proativos (contas vencendo/atrasadas e resumo semanal às segundas),
# conforme Configurações > Notificações de cada usuário:
# WHATSAPP_DIGEST_HOUR=8
# WHATSAPP_DIGEST_DISABLED=false
