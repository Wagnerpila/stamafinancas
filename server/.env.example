# Local SQLite database file
DATABASE_URL="file:./dev.db"

# Change this to a long random string in any real deployment
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

PORT=3001

# Origin(s) allowed to call the API. Comma-separated. Leave as-is for local Vite dev.
CORS_ORIGIN="http://localhost:5173"

# First user to register with this email is auto-promoted to admin.
ADMIN_EMAIL="wagtecaut@gmail.com"

# --- AI provider (optional) ---------------------------------------------
# Leave AI_PROVIDER unset (or "none") to run without AI features enabled.
# The app will keep working; AI-powered actions (OCR, voice/text parsing,
# monthly insights, consulting chat, statement import) will return a clear
# "AI not configured" error instead of crashing.
#
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Email / "Esqueci minha senha" (optional) ----------------------------
# Sem essas variáveis, o app segue funcionando normalmente — só o botão
# "Esqueci minha senha" retorna um erro claro em vez de travar silenciosamente.
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu
# email, SMTP_PASS=uma "senha de app" (não a senha normal da conta Google).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM="STAMA <seuemail@gmail.com>"

# URL pública do app, usada para montar o link de redefinição de senha no
# email. Se não definida, usa o host da própria requisição (funciona na
# maioria dos casos; defina explicitamente se estiver atrás de proxy/CDN).
# APP_URL=https://seu-dominio.com

# --- WhatsApp bot (optional) ---------------------------------------------
# Não usa a API oficial da Meta — conecta via WhatsApp Web (Baileys), escaneando
# um QR Code uma única vez no Painel Admin do app. A sessão é salva ao lado do
# banco SQLite (mesma pasta de DATABASE_URL), então persiste entre deploys.
# Nenhuma variável é obrigatória; a conexão é feita manualmente pelo admin.
# WHATSAPP_SESSION_DIR=/app/data/whatsapp-session
# WHATSAPP_LOG_LEVEL=silent
